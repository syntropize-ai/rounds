# Rounds Environment Configuration
# Copy this file to .env and fill in your values
#
# Every variable below is read by the server. If you add one here, make sure
# something in packages/*/src actually reads it, and mirror it in
# docs/configuration.md.

# Optional: crypto secrets. Outside NODE_ENV=production these are generated on
# first boot and persisted to <DATA_DIR>/secrets.json. Production must set both
# explicitly (minimum 32 characters) — see auth/bootstrap-secrets.ts.
# JWT_SECRET=your-secret-here-minimum-32-characters!!
# SECRET_KEY=another-secret-minimum-32-characters!!

# Optional: legacy static API keys, format "name:key,name2:key2".
# Prefer service accounts / user tokens created in the UI.
# API_KEYS=ci:your-api-key

# Optional: Server config
# PORT=3000
# CORS_ORIGINS=http://localhost:5173
# NODE_ENV=production
# ROUNDS_BASE_URL=https://rounds.example.com   # public URL used for GitHub App callbacks (APP_BASE_URL is the fallback name)
# SSRF policy: Rounds refuses to fetch connector / webhook / LLM URLs that point
# at private, loopback or link-local addresses. Set the flag below to "true" when
# Rounds legitimately talks to in-cluster or localhost services (e.g.
# http://prometheus.monitoring:9090). Leave unset on multi-tenant / public deploys.
# OPENOBS_ALLOW_PRIVATE_URLS=true              # allow connectors to point at RFC1918 / loopback hosts
# OPENOBS_RATE_LIMIT_MAX=600                   # requests per window, per IP
# OPENOBS_USER_RATE_LIMIT_MAX=600              # requests per window, per user
# PERMISSION_ESCALATION_CONTACT=#sre-oncall    # shown to the agent when it must ask for access

# Optional: Database config
# Leave DATABASE_URL unset to use the default local SQLite persistence.
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/rounds
# DATABASE_POOL_SIZE=10
# DATABASE_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false  # Set to "false" to accept self-signed Postgres SSL certs

# Optional: Local data storage
# DATA_DIR=~/.rounds                # SQLite database + generated secrets (default: <cwd>/.rounds)
# SQLITE_PATH=/path/to/db.sqlite    # Explicit path to SQLite database file (overrides DATA_DIR)

# Optional: Redis (event bus + queues + cache; required for multi-replica deployments)
# REDIS_URL=redis://localhost:6379

# Optional: Logging (pino; output is always JSON)
# LOG_LEVEL=info

# Optional: LLM provider configuration.
# The provider, model, and API key are configured in the setup wizard and stored
# encrypted in the database — there is no env var for them. The two keys below
# are only used by the wizard's "Test connection" probe when no key has been
# saved yet.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENOBS_THINKING_EFFORT=medium    # low | medium | high — extended-thinking budget
# DASHBOARD_VERIFY_GATE=0           # set to 0 to accept dashboard writes that fail verification

# Optional: Seed the first admin user on first startup (skips the wizard step).
# Seeding only happens while the user table is empty.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-at-least-12-chars
# SEED_ADMIN_LOGIN=admin
# SEED_ADMIN_NAME=Server Admin
# OPENOBS_PASSWORD_MIN_LENGTH=12    # minimum password length (default 12)

# Optional: Background workers
# ALERT_EVALUATOR_ENABLED=true          # periodic alert-rule evaluation
# ALERT_EVALUATOR_REFRESH_MS=60000
# ALERT_EVALUATOR_HA=false              # leader-lock the evaluator across replicas
# ALERT_EVALUATOR_LEADER_TTL_MS=30000
# AUTO_INVESTIGATION_ENABLED=true       # run investigations when an alert fires
# PLAN_EXPIRY_SWEEP_MS=60000
# PENDING_CHANGES_SWEEP_MS=3600000
